//@version=5
// ════════════════════════════════════════════════════════════════════════════════════════════════
// COT bitcoin CME : positions nettes par catégorie (CFTC, rapport Legacy, futures seuls)
// Dépôt Bitcoin-COT-Reports : reproduit le panneau « positions » du graphique output/graphique.html.
//
// • Position nette = positions longues − positions courtes d'une catégorie, en % de l'intérêt ouvert
//   (OI) ou en contrats. Les positions « spread » des non-commerciaux, à la fois longues et courtes,
//   n'entrent pas dans le net : les trois nets s'additionnent à zéro.
// • Affichage : chaque courbe se montre ou se masque dans Paramètres → Style, où se changent aussi les
//   couleurs (palette du dépôt, lisible sur fond clair comme sur fond sombre).
// • Dates : TradingView date chaque rapport au mardi d'arrêté des positions, comme le graphique du
//   dépôt. La CFTC le publie le vendredi suivant à 15 h 30 (New York). L'option « Afficher chaque
//   rapport à sa publication » le montre à partir du vendredi sur les graphiques quotidiens et
//   intrajournaliers. Non modélisés : les publications retardées par les shutdowns (rapport du
//   24/12/2018 publié le 01/02/2019, celui du 30/09/2025 le 19/11/2025) et les semaines fériées.
// • Tickers construits avec la bibliothèque officielle TradingView/LibraryCOT (par exemple
//   COT:133741_F_NCP_L).
// ════════════════════════════════════════════════════════════════════════════════════════════════
indicator("COT bitcoin CME : positions nettes", shorttitle = "COT BTC", precision = 2)

import TradingView/LibraryCOT/2 as cot

DAY_MS = 86400000
NC_COL = #2a78d6
C_COL  = #d95926
NR_COL = #199e70

// ───────────── Entrées ─────────────
contractIn    = input.string("133741 · Bitcoin (5 BTC)", "Contrat CFTC", options = ["133741 · Bitcoin (5 BTC)", "133742 · Micro Bitcoin (0,1 BTC)"])
unitIn        = input.string("% de l'intérêt ouvert", "Unité", options = ["% de l'intérêt ouvert", "Contrats"])
atPublication = input.bool(false, "Afficher chaque rapport à sa publication (vendredi)", tooltip = "Décochée (comme le graphique du dépôt) : chaque rapport est placé au mardi d'arrêté des positions. Cochée : il n'apparaît qu'à partir du vendredi de publication, sur les graphiques quotidiens et intrajournaliers. C'est ce qu'un trader pouvait réellement voir.")
showTable     = input.bool(true, "Tableau du dernier rapport")

// ───────────── Données COT ─────────────
code  = str.substring(contractIn, 0, 6)
tkOI  = cot.COTTickerid("Legacy", code, false, "Open Interest", "No direction", "All")
tkNCL = cot.COTTickerid("Legacy", code, false, "Noncommercial Positions", "Long", "All")
tkNCS = cot.COTTickerid("Legacy", code, false, "Noncommercial Positions", "Short", "All")
tkCL  = cot.COTTickerid("Legacy", code, false, "Commercial Positions", "Long", "All")
tkCS  = cot.COTTickerid("Legacy", code, false, "Commercial Positions", "Short", "All")
tkNRL = cot.COTTickerid("Legacy", code, false, "Nonreportable Positions", "Long", "All")
tkNRS = cot.COTTickerid("Legacy", code, false, "Nonreportable Positions", "Short", "All")

// Les séries COT n'ont qu'une barre par semaine : pas de requête intrajournalière.
tf    = timeframe.isintraday ? "D" : timeframe.period
oiR   = request.security(tkOI, tf, close, ignore_invalid_symbol = true)
ncLR  = request.security(tkNCL, tf, close, ignore_invalid_symbol = true)
ncSR  = request.security(tkNCS, tf, close, ignore_invalid_symbol = true)
cLR   = request.security(tkCL, tf, close, ignore_invalid_symbol = true)
cSR   = request.security(tkCS, tf, close, ignore_invalid_symbol = true)
nrLR  = request.security(tkNRL, tf, close, ignore_invalid_symbol = true)
nrSR  = request.security(tkNRS, tf, close, ignore_invalid_symbol = true)
// Date d'arrêté du dernier rapport (mardi 00:00 UTC), quelle que soit l'unité de temps du graphique.
asOfR = request.security(tkOI, "D", time, ignore_invalid_symbol = true)

// ───────────── Rapport affiché : à l'arrêté, ou à la publication ─────────────
var float[] cur  = array.new_float(7, na)
var float[] pend = array.new_float(7, na)
var int pendAsOf = na
var int curAsOf  = na
isNew = not na(asOfR) and (na(asOfR[1]) or asOfR != asOfR[1])
if isNew
    pend     := array.from(oiR, ncLR, ncSR, cLR, cSR, nrLR, nrSR)
    pendAsOf := asOfR
shiftToFriday = atPublication and (timeframe.isintraday or timeframe.isdaily)
released = false
if not na(pendAsOf) and (not shiftToFriday or time >= pendAsOf + 3 * DAY_MS)
    cur      := pend
    curAsOf  := pendAsOf
    pendAsOf := na
    released := true

oi      = array.get(cur, 0)
ncNet   = array.get(cur, 1) - array.get(cur, 2)
cNet    = array.get(cur, 3) - array.get(cur, 4)
nrNet   = array.get(cur, 5) - array.get(cur, 6)
isPct   = unitIn == "% de l'intérêt ouvert"
toUnit(float x) =>
    isPct ? x / oi * 100 : x

// Passage net short : semaine précédente nette longue (≥ 0), semaine affichée nette courte (< 0).
crossShort = released and not na(ncNet) and not na(ncNet[1]) and ncNet < 0 and ncNet[1] >= 0
crossLong  = released and not na(ncNet) and not na(ncNet[1]) and ncNet >= 0 and ncNet[1] < 0

// ───────────── Tracés : cases à cocher dans Paramètres → Style ─────────────
hline(0, "Zéro", color.new(color.gray, 30))
plot(toUnit(ncNet), "Non-commerciaux (net)", NC_COL, 2)
plot(toUnit(cNet), "Commerciaux (net)", C_COL, 2)
plot(toUnit(nrNet), "Non-déclarants (net)", NR_COL, 2)
plot(crossShort ? toUnit(ncNet) : na, "Passage net short", NC_COL, 5, plot.style_circles)

// ───────────── Tableau du dernier rapport ─────────────
fmtNet(float x) =>
    na(x) ? "—" : (x >= 0 ? "+" : "") + str.tostring(x, isPct ? "0.00" : "0") + (isPct ? " %" : "")

var table tb = table.new(position.top_right, 2, 4, bgcolor = color.new(chart.bg_color, 15))
if showTable and barstate.islast
    ink = chart.fg_color
    dateTxt = na(curAsOf) ? "Données COT indisponibles" : "Arrêté du " + str.format_time(curAsOf, "dd/MM/yyyy", "UTC")
    table.cell(tb, 0, 0, dateTxt, text_color = ink, text_size = size.small, text_halign = text.align_left, tooltip = "Ticker : " + tkNCL)
    table.cell(tb, 1, 0, isPct ? "% OI" : "contrats", text_color = ink, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 1, "Non-commerciaux", text_color = NC_COL, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 1, fmtNet(toUnit(ncNet)), text_color = ink, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 2, "Commerciaux", text_color = C_COL, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 2, fmtNet(toUnit(cNet)), text_color = ink, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 3, "Non-déclarants", text_color = NR_COL, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 3, fmtNet(toUnit(nrNet)), text_color = ink, text_size = size.small, text_halign = text.align_right)

// ───────────── Alertes ─────────────
alertcondition(crossShort, "COT BTC : passage net short", "COT bitcoin CME : les non-commerciaux passent nets courts.")
alertcondition(crossLong, "COT BTC : passage net long", "COT bitcoin CME : les non-commerciaux repassent nets longs.")
